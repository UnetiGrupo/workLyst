# Plantilla de variables de entorno del frontend.
# Copia este archivo a `.env` y ajusta los valores según el entorno.

# URL base del backend REST (obligatoria en modo real).
VITE_API_URL=http://localhost:4000

# API Key enviada en el header `x-api-key` (obligatoria en modo real).
VITE_API_KEY=

# Modo del cliente de datos: acepta `mock|real`.
# Valor por defecto: `mock` (permite desarrollar y probar sin backend).
VITE_API_MODE=mock
