{
  "name": "worklyst-monorepo",
  "private": true,
  "scripts": {
    "dev:ui": "pnpm --filter @worklyst/frontend dev",
    "dev:api": "pnpm --filter @worklyst/backend dev",
    "build:ui": "pnpm --filter @worklyst/frontend build",
    "build:api": "pnpm --filter @worklyst/backend build"
